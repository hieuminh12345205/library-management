PORT=3000
# Postgres cài trên máy: cổng 5432. Chạy DB bằng docker compose: đổi thành 5433.
DATABASE_URL=postgres://library:library@localhost:5432/library
# Neon: DATABASE_URL dùng chuỗi pooled; DATABASE_URL_UNPOOLED là chuỗi kết nối trực tiếp (dùng khi tạo bảng)
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DB?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string
